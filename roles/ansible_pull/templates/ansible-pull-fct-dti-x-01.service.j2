[Unit]
Description=Apply FCT-DTI-X-01 Ansible source of truth
Documentation={{ server_docs_url }}
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/ansible-pull/fct-dti-x-01.env
WorkingDirectory=/opt/ansible-pull
ExecStartPre=/usr/bin/ansible-galaxy collection install community.docker
ExecStart=/usr/bin/ansible-pull --url ${ANSIBLE_PULL_REPO} --checkout ${ANSIBLE_PULL_VERSION} --directory ${ANSIBLE_PULL_CHECKOUT} --clean --inventory ${ANSIBLE_PULL_INVENTORY} ${ANSIBLE_PULL_PLAYBOOK}
