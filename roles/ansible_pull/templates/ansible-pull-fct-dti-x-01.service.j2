[Unit]
Description=Apply FCT-DTI-X-01 Ansible source of truth
Documentation={{ server_docs_url }}
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/ansible-pull/fct-dti-x-01.env
WorkingDirectory=/opt/ansible-pull
ExecStartPre=/usr/bin/ansible-galaxy collection install community.docker
{% if ansible_pull_deployment_telemetry_enabled | bool %}
ExecStart={{ ansible_pull_deployment_telemetry_wrapper_path }}
{% else %}
ExecStart=/usr/bin/ansible-pull --url ${ANSIBLE_PULL_REPO} --checkout ${ANSIBLE_PULL_VERSION} --directory ${ANSIBLE_PULL_CHECKOUT} --clean --inventory ${ANSIBLE_PULL_INVENTORY}{% if ansible_pull_verbosity | int > 0 %} -{{ 'v' * (ansible_pull_verbosity | int) }}{% endif %}{% if ansible_pull_show_diff | bool %} --diff{% endif %} ${ANSIBLE_PULL_PLAYBOOK}
{% endif %}
